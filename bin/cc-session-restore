#!/usr/bin/env bash
# cc-session-restore — snapshot & restore open Claude Code (iTerm2) sessions across reboots.
#
# A reboot kills the `claude` processes but not the conversations (Claude journals each
# session to <config>/projects/...). This tool records which sessions are open and reopens
# them afterwards with `claude --resume <id>`, carrying over the flags each session was
# started with (--dangerously-skip-permissions, --model, --add-dir, ...).
#
# Source of truth: <config>/sessions/<PID>.json, which Claude Code maintains for every
# running session ({"pid","sessionId","cwd","name","status",...}). This is exact for bare
# `claude`, `--resume <uuid>`, and `--resume <name>`/picker-resumed sessions alike.
# The one thing that file does not record is argv, so the snapshot reads that straight
# off the live process (see cmd_snapshot).
#
# https://github.com/asadtariq96/cc-session-restore
set -uo pipefail

VERSION="0.1.0"
LABEL="io.github.cc-session-restore"

# minimal, predictable environment (matters when run under launchd)
export LC_ALL=C
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

# --- paths -------------------------------------------------------------------
: "${CLAUDE_CONFIG_DIR:=$HOME/.claude}"
SESSIONS_DIR="$CLAUDE_CONFIG_DIR/sessions"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cc-session-restore"
SNAPSHOT="$STATE_DIR/snapshot.tsv"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

err() { printf 'cc-session-restore: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "macOS-only (needs launchd + iTerm2)."
}

self_path() {
  local s="${BASH_SOURCE[0]}"
  ( cd "$(dirname "$s")" >/dev/null 2>&1 && printf '%s/%s\n' "$(pwd -P)" "$(basename "$s")" )
}

# --- JSON readers (no jq dependency) -----------------------------------------
# plutil ships with every macOS and parses JSON properly. A hand-rolled
# "key":"([^"]*)" grep gets a cwd like /tmp/dir "x" y wrong: the value is stored
# escaped, so the match stops at the first \" and the path comes back truncated.
# Values are read via $(...) first (which drops the trailing newline plutil adds)
# and only then flattened, so a tab or newline inside a name cannot break the TSV.
json_get() {
  local v
  v="$(plutil -extract "$2" raw -o - "$1" 2>/dev/null)" || return 1
  printf '%s' "$v" | tr '\t\n' '  '
}

# --- live session ids --------------------------------------------------------
# Space-padded list of sessionIds that still have a live `claude` process, so
# membership is a plain glob match (bash 3.2 under launchd has no assoc arrays).
live_sids() {
  local f pid sid comm out=" "
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    pid="$(json_get "$f" pid)"
    sid="$(json_get "$f" sessionId)"
    if [ -z "$pid" ] || [ -z "$sid" ]; then continue; fi
    comm="$(ps -o comm= -p "$pid" 2>/dev/null)" || continue
    case "$comm" in *claude) ;; *) continue ;; esac
    case "$out" in *" $sid "*) continue ;; esac
    out="$out$sid "
  done
  printf '%s' "$out"
}

# --- snapshot ----------------------------------------------------------------
# Snapshot format (TSV, 5 columns):
#   sessionId <TAB> cwd <TAB> title <TAB> nameSource <TAB> argv
# argv comes last so `read` can take the rest of the line in one go. Rows written
# by older versions have 3 columns; they still restore, just without flags.
cmd_snapshot() {
  require_macos
  [ -d "$SESSIONS_DIR" ] || die "Claude session dir not found: $SESSIONS_DIR
(Is Claude Code installed and recent enough? Set CLAUDE_CONFIG_DIR if you relocated ~/.claude.)"
  mkdir -p "$STATE_DIR"
  local tmp; tmp="$(mktemp "$STATE_DIR/.snap.XXXXXX")"
  local claimed=" " f pid sid cwd name nsrc entry comm title args
  local transcripts

  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    pid="$(json_get "$f" pid)"
    sid="$(json_get "$f" sessionId)"
    cwd="$(json_get "$f" cwd)"
    name="$(json_get "$f" name)"
    nsrc="$(json_get "$f" nameSource)"
    entry="$(json_get "$f" entrypoint)"
    if [ -z "$pid" ] || [ -z "$sid" ]; then continue; fi
    # only sessions a person is sitting in front of get a tab back. Hooks and SDK
    # callers run `claude --print ...` and register as entrypoint "sdk-cli"; they
    # are short-lived and reopening them as interactive tabs is nonsense. An
    # absent entrypoint means an older Claude Code, so don't filter on it.
    case "$entry" in ""|cli) ;; *) continue ;; esac
    # keep only PIDs that are still a live `claude` process (reject recycled PIDs)
    comm="$(ps -o comm= -p "$pid" 2>/dev/null)" || continue
    case "$comm" in *claude) ;; *) continue ;; esac
    case "$claimed" in *" $sid "*) continue ;; esac
    # A session Claude Code has not journalled yet cannot be resumed — the new
    # tab would come up on "No conversation found with session ID". It joins the
    # snapshot on a later tick, once the conversation has something in it.
    transcripts=("$CLAUDE_CONFIG_DIR"/projects/*/"$sid".jsonl)
    [ -f "${transcripts[0]}" ] || continue
    claimed="$claimed$sid "
    title="${name:-$(basename "$cwd")}"
    # How the session was launched exists nowhere on disk — not in the session
    # JSON, not in the transcript (its permissionMode is the *current* mode), not
    # in ~/.claude.json. It only exists in the process, so read it while the PID
    # is alive.
    #
    # The LC_ALL override is load-bearing: under LC_ALL=C (set at the top of this
    # script) ps vis-escapes every non-ASCII byte, turning an argument like
    # /Users/me/Документы into M-PM^TM-PM->M-PM-:... A UTF-8 LC_CTYPE keeps the
    # bytes intact.
    #
    # Caveat: ps joins argv with spaces and quotes nothing, so an argument that
    # itself contains a space comes back as two tokens and will split on restore
    # (it escapes tab and newline as \011 and \012, but not the backslash that
    # introduces them). The exact NUL-separated argv needs sysctl KERN_PROCARGS2,
    # which is out of reach from bash; the likeliest such argument — the session
    # name — is carried in the nameSource/title columns instead.
    args="$(env LC_ALL= LC_CTYPE=UTF-8 ps -ww -o args= -p "$pid" 2>/dev/null | tr '\t\n' '  ')"
    printf '%s\t%s\t%s\t%s\t%s\n' "$sid" "$cwd" "$title" "$nsrc" "$args" >> "$tmp"
  done

  local n; n="$(grep -c . "$tmp" 2>/dev/null || true)"; n="${n:-0}"
  # don't clobber a good snapshot with an empty one (e.g. run mid-shutdown)
  if [ "$n" -eq 0 ] && [ -s "$SNAPSHOT" ]; then
    rm -f "$tmp"; echo "snapshot: 0 live sessions; kept existing $SNAPSHOT"; return 0
  fi
  mv "$tmp" "$SNAPSHOT"
  echo "snapshot: captured $n live session(s) -> $SNAPSHOT"
}

# --- argv filtering ----------------------------------------------------------
# Flags to drop: they pick an existing conversation, run non-interactively, or
# create a new worktree — all of which fight with the `--resume <id>` we append.
# -n/--name is dropped here and re-added from the session JSON, where the name is
# a single field rather than space-split argv.
CCSR_DROP_OPTVAL="-r --resume --from-pr --cloud --teleport -w --worktree"
CCSR_DROP_VAL="--session-id -n --name"
CCSR_DROP_BARE="-c --continue --fork-session --tmux -p --print --bg --background"

# Variadic flags, which swallow every bare token behind them. This is the only
# keep-list left: everything else is classified by position (see filter_args),
# so a flag added by a future Claude Code release needs no entry here.
CCSR_KEEP_MANY="--add-dir --allowedTools --allowed-tools --disallowedTools --disallowed-tools --betas --file --mcp-config --tools"

CCSR_KEPT=""
CCSR_DROPPED=""

in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }

# Shell-quote, but only when the token actually needs it: the characters below
# are inert in both bash and zsh, and leaving them alone keeps --dry-run output
# readable (--disallowed-tools=A,B rather than --disallowed-tools=A\,B).
q() {
  case "$1" in
    ""|*[!A-Za-z0-9_.,:/=@+-]*) printf '%q' "$1" ;;
    *)                          printf '%s' "$1" ;;
  esac
}
keep_tok() { CCSR_KEPT="$CCSR_KEPT $(q "$1")"; }
drop_tok() { CCSR_DROPPED="$CCSR_DROPPED $1"; }

# filter_args <argv...> -> sets CCSR_KEPT (shell-quoted) and CCSR_DROPPED (plain)
#
# A bare token is classified by what sits in front of it rather than by a table
# of flag names: it is the value of the preceding flag when that flag was a
# `-`-token without `=`, and the positional prompt otherwise. A flag's value
# always stands immediately behind its flag, so this holds for flags this script
# has never heard of — `--future-flag value` carries the value across instead of
# stranding `--future-flag` with nothing after it. The `=` test is what keeps
# `claude --model=sonnet "fix the tests"` from re-sending the prompt.
filter_args() {
  CCSR_KEPT=""
  CCSR_DROPPED=""
  local t base next flag=0
  local drop_bare="$CCSR_DROP_BARE" drop_val="$CCSR_DROP_VAL"
  # once the session's real permission mode is known, whatever argv asked for is
  # stale — drop it here, re-add the mode that was read in build_cmd
  if [ "$CCSR_DROP_PERM" = 1 ]; then
    drop_bare="$drop_bare $CCSR_PERM_DROP_BARE"
    drop_val="$drop_val $CCSR_PERM_DROP_VAL"
  fi
  while [ "$#" -gt 0 ]; do
    t="$1"; shift
    # --flag=value arrives as one token and carries its own value
    case "$t" in
      --*=*) base="${t%%=*}" ;;
      *)     base="$t" ;;
    esac
    next="${1:-}"

    # a dropped flag takes its value with it, so nothing is left dangling behind
    # it: every drop branch clears `flag`.
    if in_list "$base" "$CCSR_DROP_OPTVAL"; then
      drop_tok "$t"; flag=0
      if [ "$t" = "$base" ]; then
        case "$next" in ""|-*) ;; *) drop_tok "$next"; shift ;; esac
      fi
    elif in_list "$base" "$drop_val"; then
      drop_tok "$t"; flag=0
      if [ "$t" = "$base" ] && [ "$#" -gt 0 ]; then drop_tok "$next"; shift; fi
    elif in_list "$base" "$drop_bare"; then
      drop_tok "$t"; flag=0
    elif in_list "$base" "$CCSR_KEEP_MANY"; then
      keep_tok "$t"; flag=0
      if [ "$t" = "$base" ]; then
        while [ "$#" -gt 0 ]; do
          case "$1" in -*) break ;; *) keep_tok "$1"; shift ;; esac
        done
      fi
    else
      case "$t" in
        -*) keep_tok "$t"
            # `--flag=value` carries its own value; a bare `--flag` may claim
            # the token behind it
            if [ "$t" = "$base" ]; then flag=1; else flag=0; fi
            ;;
        # a bare token behind a bare flag is that flag's value; otherwise it is
        # the positional prompt, and resuming with it would re-submit that
        # prompt to the conversation
        *)  if [ "$flag" = 1 ]; then keep_tok "$t"; else drop_tok "$t"; fi
            flag=0
            ;;
      esac
    fi
  done
}

# --- permission mode ---------------------------------------------------------
# The mode a session ends in is rarely the mode it was launched with — shift-tab
# and /permissions change it and argv never learns. Claude Code journals every
# switch to the transcript as a record of its own, so the last one is the mode
# the session was actually sitting in when it died.
#
# `default` is missing from the "Allowed choices" the CLI prints for a bad
# --permission-mode, but the transcript writes it and `claude --permission-mode
# default` is accepted (measured on 2.1.266), so it belongs here.
CCSR_MODES="default acceptEdits auto bypassPermissions manual dontAsk plan"

# `--dangerously-skip-permissions` overrides `--permission-mode` outright —
# measured: `--dangerously-skip-permissions --permission-mode manual` still runs
# Bash unprompted — so it cannot come back alongside a restored mode. Its
# `--allow-` sibling only keeps bypass reachable in the shift-tab cycle without
# switching to it, which is what a restored non-bypass mode needs.
CCSR_PERM_DROP_BARE="--dangerously-skip-permissions --allow-dangerously-skip-permissions"
CCSR_PERM_DROP_VAL="--permission-mode"

CCSR_DROP_PERM=0          # set per session by build_cmd, read by filter_args
CCSR_LAUNCH_FLAGS_ONLY=0  # `restore --launch-flags-only` goes back to reading argv alone
CCSR_MODE=""

# last_permission_mode <sessionId> -> prints the mode the session ended in, or nothing
last_permission_mode() {
  local sid="$1" f m transcripts
  transcripts=("$CLAUDE_CONFIG_DIR"/projects/*/"$sid".jsonl)
  for f in "${transcripts[@]}"; do
    [ -f "$f" ] || continue
    # `tail -r` (BSD, in /usr/bin, so inside this script's trimmed PATH) reverses
    # the file, which turns "last record" into "first match" — ~5ms on a 1MB
    # transcript instead of a full scan. Its exit status is no use: grep -m1
    # closes the pipe and tail dies on SIGPIPE, so the match is judged by content.
    m="$(tail -r "$f" 2>/dev/null | grep -m1 -o '"type":"permission-mode","permissionMode":"[a-zA-Z]*"')"
    [ -n "$m" ] || continue
    m="${m##*:\"}"; m="${m%\"}"
    # a mode from a newer Claude Code than this script knows about: leave the
    # command alone rather than build one the CLI will refuse to start
    in_list "$m" "$CCSR_MODES" || continue
    printf '%s' "$m"
    return 0
  done
  return 1
}

# build_cmd <sid> <cwd> <title> <nameSource> <argv> -> sets CCSR_CMD, CCSR_DROPPED, CCSR_MODE
build_cmd() {
  local sid="$1" cwd="$2" title="$3" nsrc="$4" args="$5"
  local launcher argv0 name_opt="" perm_opt="" allow=0
  CCSR_KEPT=""
  CCSR_DROPPED=""
  CCSR_MODE=""
  CCSR_DROP_PERM=0

  if [ "$CCSR_LAUNCH_FLAGS_ONLY" = 0 ]; then
    CCSR_MODE="$(last_permission_mode "$sid")"
    [ -n "$CCSR_MODE" ] && CCSR_DROP_PERM=1
  fi

  if [ -n "$args" ]; then
    # ps already joined argv with spaces; re-split it the same way the shell will
    # shellcheck disable=SC2086
    set -- $args
    argv0="$1"; shift
    # `command` matters: a shell alias for `claude` would re-apply flags that are
    # already captured in argv (e.g. alias claude='claude --disallowed-tools=...')
    case "$argv0" in
      */*) launcher="$(q "$argv0")" ;;
      *)   launcher="command claude" ;;
    esac
    filter_args "$@"
  else
    # pre-5-column snapshot row: no argv, so behave exactly like older versions
    # and let the user's own alias/function for `claude` apply
    launcher="claude"
  fi

  # a derived name was generated by Claude Code, not asked for — don't pin it
  case "$nsrc" in
    ""|derived) ;;
    *) [ -n "$title" ] && name_opt=" -n $(q "$title")" ;;
  esac

  if [ -n "$CCSR_MODE" ]; then
    # bypass belongs in the restored tab's shift-tab cycle if the command line
    # allowed it — or if the session ended in it, which proves it was allowed.
    case " $args " in
      *" --dangerously-skip-permissions "*|*" --allow-dangerously-skip-permissions "*) allow=1 ;;
    esac
    [ "$CCSR_MODE" = bypassPermissions ] && allow=1
    [ "$allow" = 1 ] && perm_opt=" --allow-dangerously-skip-permissions"
    perm_opt="$perm_opt --permission-mode $CCSR_MODE"
  fi

  CCSR_CMD="cd $(q "$cwd") && ${launcher}${CCSR_KEPT}${name_opt}${perm_opt} --resume ${sid}"
}

# --- restore -----------------------------------------------------------------
cmd_restore() {
  require_macos
  local dry=0 force=0 a
  for a in "$@"; do
    case "$a" in
      --dry-run) dry=1 ;;
      --force)   force=1 ;;
      --launch-flags-only) CCSR_LAUNCH_FLAGS_ONLY=1 ;;
      *) die "usage: cc-session-restore restore [--dry-run] [--force] [--launch-flags-only]" ;;
    esac
  done
  [ -s "$SNAPSHOT" ] || die "no snapshot at $SNAPSHOT (run: cc-session-restore snapshot)"

  # sessions that are already open don't need a second tab pointing at them
  local live=" "
  [ "$force" = 1 ] || live="$(live_sids)"

  local osa first=1 sid cwd title nsrc args esc mode
  local launched=0 skipped=0
  osa='tell application "iTerm2"
  activate
  set w to (create window with default profile)
'
  [ "$dry" = 1 ] && echo "restore (dry-run): $(grep -c . "$SNAPSHOT") session(s)"

  while IFS=$'\t' read -r sid cwd title nsrc args; do
    [ -n "$sid" ] || continue
    case "$live" in
      *" $sid "*)
        skipped=$((skipped + 1))
        if [ "$dry" = 1 ]; then
          printf '  %s  (%s)\n     skip — already running\n' "$title" "$sid"
          mode=""
          [ "$CCSR_LAUNCH_FLAGS_ONLY" = 1 ] || mode="$(last_permission_mode "$sid")"
          [ -n "$mode" ] && printf '     permission mode: %s\n' "$mode"
        fi
        continue
        ;;
    esac

    build_cmd "$sid" "$cwd" "$title" "$nsrc" "$args"
    launched=$((launched + 1))

    if [ "$dry" = 1 ]; then
      printf '  %s  (%s)\n     %s\n' "$title" "$sid" "$CCSR_CMD"
      [ -n "$CCSR_MODE" ] && printf '     permission mode: %s (restored from transcript)\n' "$CCSR_MODE"
      [ -n "$CCSR_DROPPED" ] && printf '     dropped:%s\n' "$CCSR_DROPPED"
      continue
    fi

    # AppleScript string literals only special-case backslash and double quote
    esc="$(printf '%s' "$CCSR_CMD" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    if [ "$first" = 1 ]; then
      osa+="  tell current session of w to write text \"$esc\"
"
      first=0
    else
      osa+="  tell w to create tab with default profile
  tell current session of w to write text \"$esc\"
"
    fi
  done < "$SNAPSHOT"
  osa+='end tell'

  if [ "$dry" = 1 ]; then
    printf 'restore (dry-run): would launch %s tab(s), skip %s already running\n' "$launched" "$skipped"
    return 0
  fi

  if [ "$launched" -eq 0 ]; then
    echo "restore: nothing to do — all $skipped snapshotted session(s) are already running."
    return 0
  fi

  osascript -e 'id of app "iTerm"' >/dev/null 2>&1 \
    || die "iTerm2 not found — this version restores into iTerm2 only."
  printf '%s\n' "$osa" | osascript -
  printf 'restore: launched %s tab(s), skipped %s already running.\n' "$launched" "$skipped"
}

# --- launch agent ------------------------------------------------------------
agent_install() {
  require_macos
  local bin gui; bin="$(self_path)"; gui="gui/$(id -u)"
  mkdir -p "$STATE_DIR" "$(dirname "$PLIST")"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$bin</string>
    <string>snapshot</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$STATE_DIR/agent.log</string>
  <key>StandardErrorPath</key><string>$STATE_DIR/agent.err.log</string>
</dict>
</plist>
PLIST
  launchctl bootout "$gui/$LABEL" 2>/dev/null || true
  launchctl bootstrap "$gui" "$PLIST" || die "failed to load LaunchAgent"
  launchctl kickstart -k "$gui/$LABEL" 2>/dev/null || true
  echo "agent: installed and loaded ($LABEL) — snapshots every 60s."
}

agent_uninstall() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$PLIST"
  echo "agent: unloaded and removed."
}

cmd_agent() {
  case "${1:-}" in
    install)   agent_install ;;
    uninstall) agent_uninstall ;;
    status)    cmd_status ;;
    *) die "usage: cc-session-restore agent {install|uninstall|status}" ;;
  esac
}

# --- status ------------------------------------------------------------------
cmd_status() {
  echo "cc-session-restore $VERSION"
  local found="(MISSING)"; [ -d "$SESSIONS_DIR" ] && found="(found)"
  printf 'claude sessions: %s %s\n' "$SESSIONS_DIR" "$found"
  echo "state dir:       $STATE_DIR"
  if [ -s "$SNAPSHOT" ]; then
    local rows withargs
    rows="$(grep -c . "$SNAPSHOT")"
    withargs="$(awk -F'\t' '$5 != "" { n++ } END { print n+0 }' "$SNAPSHOT")"
    printf 'last snapshot:   %s — %s session(s)\n' "$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$SNAPSHOT")" "$rows"
    printf 'argv captured:   %s of %s row(s)\n' "$withargs" "$rows"
  else
    echo "last snapshot:   (none)"
  fi
  if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
    echo "launch agent:    loaded ($LABEL)"
  else
    echo "launch agent:    not loaded"
  fi
}

# --- uninstall (everything) --------------------------------------------------
cmd_uninstall() {
  require_macos
  agent_uninstall
  rm -rf "$STATE_DIR"
  echo "removed state at $STATE_DIR"
  echo "to finish, delete the binary:  rm -f \"$(self_path)\""
}

usage() {
  cat <<EOF
cc-session-restore $VERSION — resume Claude Code (iTerm2) sessions across reboots.

USAGE:
  cc-session-restore <command>

COMMANDS:
  snapshot              Record currently-open Claude sessions to the snapshot file
  restore [options]     Reopen one iTerm2 window with a tab per snapshotted session
      --dry-run         Print the commands that would run, and what was filtered out
      --force           Also reopen sessions that are still running (default: skip them)
      --launch-flags-only
                        Restore the permission mode from the launch flags only,
                        ignoring the mode the session was switched to
  status                Show config / snapshot / agent status
  agent install         Install + load the 60s auto-snapshot LaunchAgent
  agent uninstall       Unload + remove the LaunchAgent
  uninstall             Remove the agent and state (prints how to delete the binary)
  --version             Print version
  --help                Show this help

Once the agent is installed, snapshots run automatically every 60s.
After a reboot, run:  cc-session-restore restore
EOF
}

main() {
  case "${1:-}" in
    snapshot)             shift; cmd_snapshot "$@" ;;
    restore)              shift; cmd_restore "$@" ;;
    status)               shift; cmd_status "$@" ;;
    agent)                shift; cmd_agent "$@" ;;
    uninstall)            shift; cmd_uninstall "$@" ;;
    -v|--version|version) echo "cc-session-restore $VERSION" ;;
    ""|-h|--help|help)    usage ;;
    *) err "unknown command: $1"; usage; exit 1 ;;
  esac
}
main "$@"
